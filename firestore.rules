rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    match /lobbies/{lobbyId} {
      allow read: if signedIn();
      allow create: if signedIn()
        && request.resource.data.hostId == request.auth.uid
        && request.resource.data.status == 'open'
        && request.resource.data.maxPlayers == 3;
      allow update: if signedIn()
        && (
          resource.data.hostId == request.auth.uid
          || request.resource.data.diff(resource.data).changedKeys().hasOnly(['updatedAt', 'playerCount'])
        );
      allow delete: if signedIn() && resource.data.hostId == request.auth.uid;

      match /players/{playerId} {
        allow read: if signedIn();
        allow create, update: if signedIn() && playerId == request.auth.uid;
        allow delete: if signedIn() && playerId == request.auth.uid;
      }

      match /signals/{guestId} {
        allow read: if signedIn();
        allow create, update: if signedIn();
        allow delete: if signedIn();

        match /{candidateSide}/{candidateId} {
          allow read: if signedIn();
          allow create: if signedIn()
            && candidateSide in ['hostCandidates', 'guestCandidates'];
          allow update, delete: if false;
        }
      }
    }
  }
}
